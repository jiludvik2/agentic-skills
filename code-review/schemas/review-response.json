{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review.skill/schemas/review-response.json",
  "title": "code-review consolidated output",
  "description": "The consolidated JSON document emitted by the CLI: one entry per analyzer.",
  "type": "object",
  "required": ["analyzers"],
  "additionalProperties": false,
  "properties": {
    "analyzers": {
      "type": "object",
      "description": "Map of analyzer id to its output.",
      "additionalProperties": {
        "type": "object",
        "required": ["sarif", "metrics", "duration_s", "status", "error"],
        "additionalProperties": true,
        "properties": {
          "sarif": {
            "type": "object",
            "description": "SARIF 2.1.0 document (see schemas/sarif-2.1.0.json)."
          },
          "metrics": {
            "type": ["object", "null"],
            "properties": {
              "per_file": {"type": "object"},
              "per_class": {"type": "object"},
              "coupling": {"type": "object"}
            }
          },
          "duration_s": {"type": "number", "minimum": 0},
          "status": {"enum": ["ok", "error", "timeout"]},
          "error": {"type": ["string", "null"]},
          "raw_output_path": {"type": ["string", "null"]}
        }
      }
    }
  }
}
