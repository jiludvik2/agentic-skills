{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://code-review.skill/schemas/review-bundle.v1.json",
  "title": "polyreview review bundle (v1)",
  "description": "The thin-runner contract (ADR-0020): the review request echo plus one raw CaptureOutput per tool. Constrains structure only — the content of `stdout`/`stderr` is deliberately opaque (the agent interprets it).",
  "type": "object",
  "required": ["schema", "request", "outputs"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "polyreview/review-bundle/v1"
    },
    "request": {
      "type": "object",
      "required": ["scope", "diff_range", "target_paths", "languages"],
      "additionalProperties": false,
      "properties": {
        "scope": {"type": "string"},
        "diff_range": {"type": ["string", "null"]},
        "target_paths": {"type": "array", "items": {"type": "string"}},
        "languages": {"type": "array", "items": {"type": "string"}}
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool", "status"],
        "additionalProperties": false,
        "properties": {
          "tool": {"type": "string"},
          "status": {
            "description": "ADR-0019 status taxonomy.",
            "enum": ["ok", "error", "timeout", "unavailable"]
          },
          "exit_code": {"type": ["integer", "null"]},
          "stdout": {"type": "string"},
          "stderr": {"type": "string"},
          "error": {"type": ["string", "null"]},
          "command": {"type": "array", "items": {"type": "string"}},
          "duration_s": {"type": "number"}
        }
      }
    }
  }
}
