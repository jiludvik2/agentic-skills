{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-review.skill/schemas/capabilities.json",
  "title": "code-review capabilities",
  "description": "Static capability declaration for the code-review skill.",
  "type": "object",
  "required": ["review_kinds", "stack_coverage", "analyzers", "taxonomies"],
  "additionalProperties": true,
  "properties": {
    "review_kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "scope", "expected_duration_s"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "description": {"type": "string"},
          "scope": {"enum": ["diff", "cumulative-diff", "story-level-only"]},
          "expected_duration_s": {
            "type": "object",
            "required": ["min", "max"],
            "additionalProperties": false,
            "properties": {
              "min": {"type": "number", "minimum": 0},
              "max": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    },
    "stack_coverage": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["version_range", "frameworks"],
        "additionalProperties": true,
        "properties": {
          "status": {"enum": ["verified", "planned"]},
          "version_range": {"type": "string"},
          "analyzer_classes": {"type": "array", "items": {"type": "string"}},
          "frameworks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "version_range"],
              "additionalProperties": true,
              "properties": {
                "name": {"type": "string"},
                "version_range": {"type": "string"},
                "status": {"enum": ["verified", "planned"]}
              }
            }
          }
        }
      }
    },
    "analyzers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "kind", "domain", "subcategory", "tier",
          "languages", "rule_classes", "taxonomies_tagged", "default_timeout_s"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["deterministic", "llm", "deterministic-runtime", "contract"]},
          "domain": {"enum": ["security", "maintainability", "contracts"]},
          "subcategory": {"type": "string", "minLength": 1},
          "tier": {"enum": ["quick", "full"]},
          "languages": {"type": "array", "items": {"type": "string"}},
          "rule_classes": {"type": "array", "items": {"type": "string"}},
          "taxonomies_tagged": {"type": "array", "items": {"type": "string"}},
          "default_timeout_s": {"type": "number", "minimum": 0},
          "scope_restriction": {"type": ["string", "null"]},
          "npm_package": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "sarif_formatter": {
            "type": "object",
            "required": ["npm_package", "version"],
            "additionalProperties": false,
            "properties": {
              "npm_package": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "taxonomies": {
      "type": "object",
      "required": ["cwe", "owasp-top-10", "sdlc-severity"],
      "additionalProperties": true,
      "properties": {
        "cwe": {
          "type": "object",
          "required": ["version"],
          "properties": {"version": {"type": "string"}}
        },
        "owasp-top-10": {
          "type": "object",
          "required": ["version"],
          "properties": {"version": {"type": "string"}}
        },
        "sdlc-severity": {
          "type": "object",
          "required": ["values"],
          "properties": {
            "values": {
              "type": "array",
              "items": {"enum": ["critical", "important", "minor", "nit"]},
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true
            }
          }
        }
      }
    }
  }
}
