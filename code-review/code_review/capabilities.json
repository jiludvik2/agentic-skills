      "expected_duration_s": {"min": 5, "max": 60}
    },
    {
      "id": "story-level",
      "description": "Review the cumulative diff of a closed story for cross-cutting drift and consistency.",
      "scope": "cumulative-diff",
      "expected_duration_s": {"min": 10, "max": 180}
    },
    {
      "id": "contract-verification",
      "description": "Exercise API contracts with property-based and consumer-driven tests (Schemathesis/Pact).",
