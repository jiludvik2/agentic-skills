## code-review.toml.example
##
## Starter template for the code-review skill's operator config.
## Copy this file to your project root (the CWD you'll invoke the CLI from)
## as `code-review.toml`, then uncomment the keys you want to override.
## See SKILL.md (skill bundle) or `python -m code_review.cli --help` for details.

## ----------------------------------------------------------------------
## Disabled analyzers (root-level key; must come before any [section]).
## ----------------------------------------------------------------------
## `disabled_analyzers` (list of strings, default empty): analyzer ids
## the CLI refuses to run. Useful when a binary is unavailable in the
## current environment and you want a clear failure instead of an
## attempted-and-errored result.

## DO NOT MOVE BELOW ANY [table] HEADER — root-level keys inherit the
## preceding table in TOML, which silently corrupts this value into the
## wrong section. Add new root-level scalars here, above the first [...] line.
# disabled_analyzers = ["trivy"]

## ----------------------------------------------------------------------
## Deduplication
## ----------------------------------------------------------------------
## `dedup.line_tolerance` (int, default 3): how many lines apart two findings
## from different analyzers can be while still treated as the same finding.

# [dedup]
# line_tolerance = 3

## ----------------------------------------------------------------------
## Severity overrides
## ----------------------------------------------------------------------
## `[severity]` (table of rule-id -> label): downgrade or upgrade specific
## rules. Labels must be one of: critical, important, minor, nit.

# [severity]
# "semgrep:python.lang.security.audit.weak-crypto" = "important"

## ----------------------------------------------------------------------
## Hotspot weights
## ----------------------------------------------------------------------
## `[hotspots.weights]` (table of metric -> float): how each per-file metric
## contributes to the hotspot ranking score. Defaults come from
## capabilities.json; override any subset.

# [hotspots.weights]
# severity_weighted_findings = 1.0
# cyclomatic_complexity = 0.5
# coupling = 0.3

## ----------------------------------------------------------------------
## Contract testing
## ----------------------------------------------------------------------
## `[contract_testing.targets.<service>]`: per-service configuration for
## the Schemathesis contract-testing adapter. `schemathesis_target` is the
## OpenAPI/JSON-Schema endpoint; `auth.token_env` names an env var holding
## the bearer token (the value itself never appears in this file).

# [contract_testing.targets.my-api]
# schemathesis_target = "http://localhost:8000/openapi.json"
# [contract_testing.targets.my-api.auth]
# token_env = "MY_API_TOKEN"
